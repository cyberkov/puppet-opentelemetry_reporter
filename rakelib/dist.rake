# frozen_string_literal: true

# Builds a single drop-in report processor from lib/.
#
# OpenVox Server loads report processors from a single file. Operators who do
# not deploy this as a Puppet module can copy the generated file into
# /etc/puppetlabs/puppet/lib/puppet/reports/ instead.

require 'fileutils'

namespace :dist do
  # Concatenated in dependency order: sdk.rb uses Config.
  SOURCES = [
    'lib/puppet_x/opentelemetry_reporter/config.rb',
    'lib/puppet_x/opentelemetry_reporter/sdk.rb',
    'lib/puppet_x/opentelemetry_reporter/metrics.rb',
    'lib/puppet_x/opentelemetry_reporter/traces.rb',
    'lib/puppet/reports/opentelemetry.rb',
  ].freeze

  OUTPUT = 'dist/opentelemetry.rb'

  # Requires of this module's own files are dropped, because the file being
  # generated already contains them. Third party requires are hoisted instead.
  #
  # Only top level requires are considered. An indented require is deliberately
  # lazy, loaded inside a method and guarded by a LoadError rescue so telemetry
  # degrades instead of failing the run, and hoisting it would defeat that.
  INTERNAL_REQUIRE = %r{^require\s+['"]puppet_x/opentelemetry_reporter/[^'"]+['"]\s*$}
  EXTERNAL_REQUIRE = %r{^require\s+['"]([^'"]+)['"]\s*$}
  LOAD_PATH_LINE = %r{^\s*\$LOAD_PATH\.}
  FROZEN_LITERAL = %r{^#\s*frozen_string_literal:}

  def strip_source(path)
    requires = []
    body = File.readlines(path).reject do |line|
      next true if line.match?(INTERNAL_REQUIRE)
      next true if line.match?(LOAD_PATH_LINE)
      next true if line.match?(FROZEN_LITERAL)

      if (match = line.match(EXTERNAL_REQUIRE))
        requires << match[1]
        next true
      end

      false
    end

    [requires, body.join.strip]
  end

  desc 'Build the single file report processor into dist/'
  task :build do
    requires = []
    bodies = SOURCES.map do |path|
      raise "missing source: #{path}" unless File.exist?(path)

      found, body = strip_source(path)
      requires.concat(found)
      "# --- #{path} ---\n\n#{body}"
    end

    header = <<~HEADER
      # frozen_string_literal: true

      # Generated by `rake dist:build` from the puppet-opentelemetry_reporter
      # module. Do not edit this file directly; edit the sources under lib/ and
      # rebuild.
      #
      # Install by copying this file to the report directory of your Puppet
      # installation, for example:
      #   /etc/puppetlabs/puppet/lib/puppet/reports/opentelemetry.rb
      #
      # Requires the opentelemetry-sdk, opentelemetry-metrics-sdk and
      # opentelemetry-exporter-otlp-metrics gems, plus
      # opentelemetry-exporter-otlp when traces are enabled. See the README.
    HEADER

    FileUtils.mkdir_p(File.dirname(OUTPUT))
    File.write(OUTPUT, "#{header}\n#{requires.uniq.sort.map { |r| "require '#{r}'" }.join("\n")}\n\n#{bodies.join("\n\n")}\n")

    puts "Wrote #{OUTPUT} (#{File.size(OUTPUT)} bytes)"
  end

  desc 'Remove the generated single file report processor'
  task :clean do
    FileUtils.rm_rf(File.dirname(OUTPUT))
  end
end
